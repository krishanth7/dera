{
  "name": "dera-monorepo",
  "version": "0.1.0-dev",
  "private": true,
  "description": "DERA — Database Engineering & Reverse Analysis",
  "author": "Krishanth <krishanth.b.2008@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/krishanth7/dera",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishanth7/dera.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run --workspaces --if-present lint",
    "docs:lint": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\"",
    "docs:links": "python scripts/ci/validate_docs.py",
    "docs:mermaid": "python scripts/ci/validate_mermaid.py",
    "docs:i18n": "python scripts/ci/validate_i18n.py",
    "docs:check": "npm run docs:lint && python scripts/ci/validate_docs.py && python scripts/ci/validate_mermaid.py && python scripts/docs/generate_language_navigation.py --check && python scripts/ci/validate_i18n.py",
    "docs:links:external": "python scripts/ci/validate_external_links.py"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.17.2",
    "typescript": "^7.0.2"
  }
}
