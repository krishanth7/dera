# ==============================================================================
# DERA — Database Engineering & Reverse Analysis
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
#   1. Copy this file to '.env' for local development.
#   2. NEVER commit '.env' containing real secrets to version control.
#   3. DERA enforces read-only access for all target database inspections.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Gateway Configuration (Server-Only)
# ------------------------------------------------------------------------------
DERA_ENV=development
DERA_API_HOST=0.0.0.0
DERA_API_PORT=8000
DERA_API_LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
DERA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Boundaries
DERA_READ_ONLY_ENFORCED=true
DERA_ZERO_AI_ENFORCED=true

# ------------------------------------------------------------------------------
# 2. Web Studio Frontend Configuration (Public)
# Notice: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# NEVER put database passwords or private tokens in NEXT_PUBLIC_ variables!
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DERA_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_MAX_DIAGRAM_NODES=250

# ------------------------------------------------------------------------------
# 3. Optional Local Development Target Databases (Local-Only Mock/Test DBs)
# Used only by integration tests and local demonstration environments.
# ------------------------------------------------------------------------------
DERA_TEST_SQLITE_PATH=:memory:
DERA_TEST_POSTGRES_HOST=localhost
DERA_TEST_POSTGRES_PORT=5432
DERA_TEST_POSTGRES_DB=dera_test
DERA_TEST_POSTGRES_USER=dera_tester
DERA_TEST_POSTGRES_PASSWORD=local_insecure_test_password
