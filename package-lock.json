{
  "name": "dera-monorepo",
  "version": "0.1.0-dev",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "dera-monorepo",
      "version": "0.1.0-dev",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "typescript": "^5.4.0"
      }
    },
    "apps/web": {
      "name": "@dera/web",
      "version": "0.1.0-dev",
      "license": "MIT",
      "dependencies": {
        "@dera/contracts": "^0.1.0-dev"
      }
    },
    "node_modules/@dera/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@dera/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@dera/contracts",
      "version": "0.1.0-dev",
      "license": "MIT"
    }
  }
}
