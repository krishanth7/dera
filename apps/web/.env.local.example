# DERA Web Application Environment Variables (Phase 7.1)
# Copy this file to .env.local for local development.

# DERA Backend REST API URL (No trailing slash)
# Do NOT put secret tokens or database passwords here.
NEXT_PUBLIC_DERA_API_URL=http://localhost:8000

# Public application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional feature flags (deterministic engineering studio)
NEXT_PUBLIC_ENABLE_SNAPSHOTS=true
NEXT_PUBLIC_ENABLE_EXPORTS=true
